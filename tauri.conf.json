{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freespace",
  "version": "1.2.0",
  "identifier": "dev.freespace.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Freespace",
        "visible": false,
        "width": 1400,
        "height": 860,
        "minWidth": 1150,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Fast disk scanner and cleaner for Windows",
    "longDescription": "Scans a drive in parallel, groups what can be cleaned (temp files, caches, build output, node_modules, logs, Windows leftovers, large files) and deletes only what you tick and confirm. Also uninstalls apps and removes what they leave behind.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/header.bmp",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFRkNFQUM0MTFGMzZGMUMKUldRY2IvTVJ4T3I4dnZxOVhxQWtTaStJelFJd05NdkplVjE4VzI2QmxvOG9KcXA2SnBlL0JxdDIK",
      "endpoints": [
        "https://github.com/ezzdin-atef/freespace/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
